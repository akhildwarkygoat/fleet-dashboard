# Batch files must keep CRLF or cmd.exe mis-parses multi-line if/for blocks.
*.bat text eol=crlf
*.cmd text eol=crlf
# Shell scripts must keep LF even when checked out on Windows.
*.sh text eol=lf
# PowerShell tolerates either, but CRLF keeps it readable in Notepad on the factory PC.
*.ps1 text eol=crlf
